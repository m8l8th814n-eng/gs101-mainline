/*
 * NFC. The silicon is an ST54J (an ST21NFC controller with an embedded secure
 * element); it binds "st,st21nfc" all the same. The vendor drives it with its
 * own driver and extra properties -- a PMU reference clock, a clock-request
 * line, a power-idle line (gs101-whitefin-nfc.dtsi). Those turned out not to
 * be needed: with just the reset GPIO the chip talks NCI and reports its full
 * protocol set (Felica, MIFARE, Jewel, ISO-DEP, NFC-DEP, ISO-15693).
 *
 * What does not work is nfc_dev_up, which fails at secure-element discovery:
 * st_nci_hci_network_init floods proprietary notifications (opcode 0xe3e) and
 * times out. That path is only for the SE, whose protocol is Google's own, so
 * st_nci_discover_se() is patched to skip it when no SE is declared here --
 * which is why this node declares none. Reader and host-card-emulation are
 * pure NCI and do not need the SE.
 */
&hsi2c_7 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <370000>;
	status = "okay";

	nfc@8 {
		compatible = "st,st21nfc";
		reg = <0x08>;

		interrupt-parent = <&gpa8>;
		interrupts = <0 IRQ_TYPE_LEVEL_HIGH>;
		reset-gpios = <&gpp24 2 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * LM3644 dual-LED camera flash (rear). Vendor drives it via its own
	 * LWIS framework ("google,lwis-i2c-device"); mainline binds the TI
	 * V4L2 flash subdev instead. Wiring from gs101 RE:
	 *   HW enable  = gpp23[6], active-high (AP2FLASH_EN)
	 *   ext strobe = gpp27[0], active-low  (optional; SW strobe over I2C
	 *                works without it)
	 * The front camera (imx355) has no LED flash.
	 */
	flash@63 {
		compatible = "ti,lm3644";
		reg = <0x63>;

		enable-gpios = <&gpp23 6 GPIO_ACTIVE_HIGH>;
		strobe-gpios = <&gpp27 0 GPIO_ACTIVE_LOW>;
	};

	/*
	 * SLG51000 camera-side PMIC. The driver powers the chip up by
	 * driving the four master-enable lines in order at probe
	 * (bb -> buck -> cs -> pu), matching the vendor camera-pmic DT.
	 * Also supplies the VL53L1 ToF sensor's VIO from ldo1.
	 */
	slg51000: pmic@75 {
		compatible = "dlg,slg51000";
		reg = <0x75>;
		dlg,bb-gpios = <&s2mpg11_gpio 1 GPIO_ACTIVE_HIGH>;
		dlg,buck-gpios = <&s2mpg11_gpio 3 GPIO_ACTIVE_HIGH>;
		dlg,cs-gpios = <&s2mpg11_gpio 0 GPIO_ACTIVE_HIGH>;
		dlg,pu-gpios = <&s2mpg11_gpio 4 GPIO_ACTIVE_HIGH>;
		/* GPIO1..4 outputs: rear main camera (GN1) module enables. */
		gpio-controller;
		#gpio-cells = <2>;

		regulators {
			/*
			 * 2026-09-21: the "bias pairing" below is the production
			 * OTP mux (regmap 0x1715..0x171b = 03 05 2c 04 05 2d 02):
			 * enable bit0 -> LDO7, bit1 -> LDO1, bit2 -> LDO4,
			 * bit3 -> LDO2+LDO5, bit4 -> LUT -> LDO6, bit6 -> GPIO4.
			 * So "ldoN" here switches a different physical LDO than
			 * its name; VSEL registers are still per physical LDO.
			 * Verified with i2ctransfer on MATRIX_CONF_A (0x110d).
			 */
			/*
			 * SLG51000 LDO bias pairing (found empirically on the
			 * device): an LDO only reaches VOUT_OK if its bias
			 * companion is also enabled -
			 *   ldo7 <- ldo1,  ldo6 <- ldo5,  ldo2/ldo5 <- ldo4.
			 * ldo3 stands alone. So ldo1, ldo4 and ldo5 are marked
			 * always-on: they are the companions that let the sensor
			 * rails (ldo3/6/7 for imx355, ldo2/5/7 for imx386) come
			 * up. Without them the sensor gets avdd but no dvdd/
			 * dovdd -> I2C tx timeout / -EIO. A companion only needs
			 * to be *enabled* to provide bias; it need not itself
			 * regulate.
			 *
			 * ldo1 = front-cam EEPROM (m24c64s @0x51) + bias for ldo7.
			 */
			slg51000_ldo1: ldo1 {
				regulator-name = "slg51000_ldo1";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			/*
			 * IMX355 front camera rails:
			 *   ldo3 = avdd  2.8 V   (reg-init 0x2300 = 0xA0)
			 *   ldo6 = dvdd  1.2 V   (reg-init 0x2900 = 0xA0)
			 *   ldo7 = dovdd 1.8 V   (reg 0x3100, HW default)
			 */
			slg51000_ldo3: ldo3 {
				regulator-name = "slg51000_ldo3";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
			};

			slg51000_ldo6: ldo6 {
				regulator-name = "slg51000_ldo6";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
			};

			slg51000_ldo7: ldo7 {
				regulator-name = "slg51000_ldo7";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			/*
			 * IMX386 rear ultra-wide rails (proto1 wiring):
			 *   ldo2 = avdd 2.8 V, ldo5 = dvdd 1.2 V, ldo7 = dovdd (shared)
			 */
			slg51000_ldo2: ldo2 {
				regulator-name = "slg51000_ldo2";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
			};

			slg51000_ldo5: ldo5 {
				regulator-name = "slg51000_ldo5";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				/* dvdd for imx386; also bias companion for ldo6 */
				regulator-always-on;
				regulator-boot-on;
			};

			/*
			 * Vendor proto1 DT: ldo4 is the GN1 (rear main camera)
			 * dvdd, with ldo1 = avdd and ldo7 = dovdd (2026-09-21).
			 */
			/*
			 * ldo4 is not wired to a sensor rail, but it is the bias
			 * companion that lets ldo2 (imx386 avdd) and ldo5 reach
			 * VOUT_OK. Kept always-on for that; voltage left at its
			 * hardware default (wide range, no clamp).
			 */
			slg51000_ldo4: ldo4 {
				regulator-name = "slg51000_ldo4";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3750000>;
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};
};

&watchdog_cl0 {
	timeout-sec = <30>;
	status = "okay";
};

&spi_11 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <>;
	cs-gpios = <&gpp23 3 GPIO_ACTIVE_LOW>;
	num-cs = <1>;
	spitouch: touchscreen@0 {
		compatible = "st,spi";
		status = "okay";
		spi-max-frequency = <10000000>;
		reg = <0>;
		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
		pinctrl-0 = <&ts_irq &ts_reset &ap2aoc &aoc2ap_irq
			     &spi11_bus &spi11_cs>;
		pinctrl-1 = <&ts_irq &ts_reset &ap2aoc &aoc2ap_irq
			     &spi11_bus &spi11_cs>;
		fts,irq-gpio = <&gpa9 0 GPIO_ACTIVE_LOW>;
		fts,irq-flags = <0x2008>; /* IRQF_TRIGGER_LOW | IRQF_ONESHOT */
		fts,reset-gpio-enable;
		fts,reset-gpio = <&gpp26 0 GPIO_ACTIVE_LOW>;
		fts,bus-reg-name = "vdd";
		fts,pwr-reg-name = "avdd";
		vdd-supply = <&s2mpg10_ldo25m>;
		avdd-supply = <&s2mpg10_ldo26m>;
		controller-data {
			samsung,spi-feedback-delay = <1>;
			samsung,spi-chip-select-mode = <0>;
			cs-clock-delay = <2>;
		};
	};
};

/*
 * CS35L41 speaker amplifiers on SPI13 (USI13). Pin assignments taken from
 * the vendor kernel (gs101-raviole-audio.dtsi). This only gets the amps to
 * probe on the SPI bus; there is no DAI link or sound card yet, so it does
 * not produce audio on its own.
 */
&pinctrl_gpio_alive {
	cs35l41_r_irq: cs35l41-r-irq-pins {
		samsung,pins = "gpa9-6"; /* XEINT_26 */
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&pinctrl_far_alive {
	cs35l41_l_irq: cs35l41-l-irq-pins {
		samsung,pins = "gpa6-3"; /* XEINT_3 */
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&pinctrl_peric0 {
	cs35l41_l_rst: cs35l41-l-rst-pins {
		samsung,pins = "gpp16-3"; /* XAPC_USI8_CTSN_CSN */
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	cs35l41_cs2: cs35l41-cs2-pins {
		samsung,pins = "gpp1-0"; /* XAPC_GPIO2 */
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&pinctrl_peric1 {
	cs35l41_r_rst: cs35l41-r-rst-pins {
		samsung,pins = "gpp23-7"; /* XAPC_USI12_CTSN_CSN */
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&spi_13 {
	#address-cells = <1>;
	#size-cells = <0>;

	pinctrl-names = "default";
	pinctrl-0 = <&spi13_bus>, <&spi13_cs>, <&cs35l41_cs2>;

	/* Both chip selects are driven as GPIOs, so gpp25-3 uses spi13_cs
	 * (output function) rather than spi13_cs_func (SPI function).
	 */
	cs-gpios = <&gpp25 3 GPIO_ACTIVE_LOW>, <&gpp1 0 GPIO_ACTIVE_LOW>;
	num-cs = <2>;

	cs35l41_l: speaker-amp@0 {
		compatible = "cirrus,cs35l41dna";
		reg = <0>;
		#sound-dai-cells = <1>;
		cirrus,subsystem-id = "oriole";
		spi-max-frequency = <25000000>;
		/* Left amp: default (no prefix); vendor sets tuning-has-prefix. */
		cirrus,tuning-has-prefix;

		pinctrl-names = "default";
		pinctrl-0 = <&cs35l41_l_irq>, <&cs35l41_l_rst>;

		interrupt-parent = <&gpa6>;
		/*
		 * IRQ_TYPE_NONE, not LEVEL_LOW. The cs35l41 driver sets the
		 * trigger polarity itself from the GPIO2 config (irq_pol =
		 * IRQF_TRIGGER_LOW in cs35l41_gpio_config). Pinning a concrete
		 * type here makes the fwspec mapping fail with "type mismatch,
		 * failed to map hwirq-3" when the module is (re)loaded after boot
		 * -- the type is not cleaned up on free_irq, so the second map
		 * conflicts and spi->irq becomes 0 (request_irq(0) -> -EINVAL).
		 * The vendor uses type 0 here for the same reason.
		 */
		interrupts = <3 IRQ_TYPE_NONE>;
		reset-gpios = <&gpp16 3 GPIO_ACTIVE_HIGH>;

		VA-supply = <&s2mpg11_bucka>;
		VP-supply = <&V_SYS_dummy>;

		cirrus,boost-peak-milliamp = <3500>;
		cirrus,boost-ind-nanohenry = <1000>;
		cirrus,boost-cap-microfarad = <30>;
		cirrus,asp-sdout-hiz = <3>;
		/*
		 * vendor parity. NOTE: mainline's cs35l41 driver does NOT
		 * parse hw-noise-gate-select (no-op here, kept for parity).
		 * cirrus,hibernate-enable REMOVED: the Sep-6 build that played
		 * did NOT have it, and on gs101 the halo DSP mailbox wake fails
		 * (latches runtime_error, storms the IRQ) -- hibernate events
		 * spam every playback prepare. Matches the working build.
		 */
		cirrus,hw-noise-gate-select = <63>;

		/*
		 * Drive the interrupt out of GPIO2 (open-drain INT), which the
		 * interrupts property above listens to. The cs35l41dna driver
		 * parses this ONLY from a cirrus,gpio-config2 child node
		 * (of_get_child_by_name, cs35l41.c:3637) -- the flat
		 * cirrus,gpio2-* form was silently ignored. src-select = 0x4
		 * per vendor (all devices: ripcurrentpro/akita/caimito).
		 */
		cirrus,gpio-config2 {
			cirrus,gpio-src-select = <0x4>;
			cirrus,gpio-output-enable;
		};

		controller-data {
			/*
			 * Compensate the MISO round trip. spi-s3c64xx writes
			 * FB_CLK on every message and leaves it at 0 when this
			 * node is absent, which is too tight for reads at the
			 * 25 MHz the vendor runs these amps at.
			 */
			samsung,spi-feedback-delay = <1>;
			/* vendor parity (s3c64xx doesn't parse this) */
			samsung,spi-chip-select-mode = <1>;
		};
	};

	cs35l41_r: speaker-amp@1 {
		compatible = "cirrus,cs35l41dna";
		reg = <1>;
		#sound-dai-cells = <1>;
		cirrus,subsystem-id = "oriole";
		spi-max-frequency = <25000000>;
		/*
		 * "R" prefix comes from the aoc codec_cfg node below (this
		 * helped on mainline); no sound-name-prefix here, to avoid a
		 * double "RR". Tuning files carry the prefix; left amp default.
		 */
		cirrus,tuning-has-prefix;

		pinctrl-names = "default";
		pinctrl-0 = <&cs35l41_r_irq>, <&cs35l41_r_rst>;

		interrupt-parent = <&gpa9>;
		/* IRQ_TYPE_NONE: driver sets polarity; see cs35l41_l above. */
		interrupts = <6 IRQ_TYPE_NONE>;
		reset-gpios = <&gpp23 7 GPIO_ACTIVE_HIGH>;

		VA-supply = <&s2mpg11_bucka>;
		VP-supply = <&V_SYS_dummy>;

		cirrus,boost-peak-milliamp = <3500>;
		cirrus,boost-ind-nanohenry = <1000>;
		cirrus,boost-cap-microfarad = <30>;
		cirrus,asp-sdout-hiz = <3>;
		/*
		 * vendor parity (mainline driver doesn't parse these two -
		 * no-ops, kept for parity). hibernate-enable REMOVED to match
		 * the Sep-6 build that played; see cs35l41_l.
		 */
		cirrus,hw-noise-gate-select = <63>;
		cirrus,right-channel-amp;

		/*
		 * Drive the interrupt out of GPIO2 (open-drain INT), which the
		 * interrupts property above listens to. The cs35l41dna driver
		 * parses this ONLY from a cirrus,gpio-config2 child node
		 * (of_get_child_by_name, cs35l41.c:3637) -- the flat
		 * cirrus,gpio2-* form was silently ignored. src-select = 0x4
		 * per vendor (all devices: ripcurrentpro/akita/caimito).
		 */
		cirrus,gpio-config2 {
			cirrus,gpio-src-select = <0x4>;
			cirrus,gpio-output-enable;
		};

		controller-data {
			samsung,spi-feedback-delay = <1>;
			/* vendor: automatic SPI CS */
			samsung,spi-chip-select-mode = <1>;
		};
	};
};

&dai_be_tdm0_rx {
	codec {
		sound-dai = <&cs35l41_l 0>, <&cs35l41_r 0>;
	};
};

&dai_be_tdm0_tx {
	codec {
		sound-dai = <&cs35l41_l 0>, <&cs35l41_r 0>;
	};
};

&aoc_snd_card {
	clks {
		sys {
			sys@cs35l41_l {
				comp = <&cs35l41_l>;
				src = "BCLK";
				id = <0>;
				srcid = <0>;
				in_mul = <1>;
				out_mul = <1>;
			};

			sys@cs35l41_r {
				comp = <&cs35l41_r>;
				src = "BCLK";
				id = <0>;
				srcid = <0>;
				in_mul = <1>;
				out_mul = <1>;
			};
		};
	};

	/*
	 * Give the right cs35l41 the "R" name-prefix via the aoc card's
	 * codec_conf path (aoc_of_parse_codec_conf reads of_node + prefix).
	 * This is what actually applied the prefix on mainline; without it the
	 * card logs "can't find codec cfg node". sound-name-prefix is NOT set
	 * on cs35l41_r, so the prefix is applied once (no "RR"). Left amp stays
	 * default; both carry cirrus,tuning-has-prefix.
	 */
	codec_cfg {
		cs35l41_r_cfg {
			of_node = <&cs35l41_r>;
			prefix = "R";
		};
	};
};

/*
 * AoC drives the sensor rails. Without the list it logs "unsupported sensor
 * power list" and leaves them alone; the vendor names the same two LDOs in
 * gs101-common.dtsi.
 */
&aoc {
	sensor_1v8-supply = <&s2mpg11_ldo7s>;
	sensor_3v3-supply = <&s2mpg11_ldo6s>;
	sensor_power_list = "sensor_1v8", "sensor_3v3";

	/*
	 * DMIC/PDM rail (ldo20m "vddq_aoc_pdm"). Let AoC manage it so the
	 * SPEECH/hotword mic setup has power. NOTE: ldo20m is regulator-always-on
	 * + ext-control (EN2), so this may be redundant; if it also feeds memory
	 * the exclusive get will fail ("failed to get dmic regulator").
	 */
	dmic-supply = <&s2mpg10_ldo20m>;
	dmic_power_list = "dmic";
};

/*
 * GNSS: Broadcom BCM4775 on SPI5.
 *
 * A discrete receiver, not the integrated Kepler GNSS that arrives with zuma
 * -- which is why fw_data[GnssType] stays 0 on this SoC. Ported from the
 * vendor's gs101-common-gps.dtsi plus gs101-slider2-gps.dtsi, which is the
 * pin set gs101-raviole.dtsi pulls in for oriole and raven.
 *
 * The vendor also sets dma-mode, a pdma0 channel pair and swap-mode on the
 * controller. Those are properties of its own SPI driver; mainline's
 * spi-s3c64xx has no equivalent, so the transfers run PIO here.
 */
&usi5 {
	samsung,mode = <USI_MODE_SPI>;
	status = "okay";
};

&spi_5 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi5_bus>, <&spi5_cs_func>;
	status = "okay";

	gnss: bcm4775@0 {
		compatible = "ssp-spi,bcm4775";
		reg = <0>;
		spi-max-frequency = <26000000>;
		spi-cpol;
		spi-cpha;

		pinctrl-names = "default";
		pinctrl-0 = <&gps_host_req>, <&gps_mcu_req>,
			    <&gps_mcu_resp>, <&gps_nstandby>;

		host-req-gpios = <&gpa6 4 GPIO_ACTIVE_HIGH>;
		mcu-req-gpios = <&gpp1 1 GPIO_ACTIVE_HIGH>;
		mcu-resp-gpios = <&gpp0 0 GPIO_ACTIVE_HIGH>;
		nstandby-gpios = <&gpp0 2 GPIO_ACTIVE_LOW>;

		controller-data {
			samsung,spi-feedback-delay = <1>;
		};
	};
};

/ {
	/* 1PPS output from the receiver. */
	bbd_pps {
		compatible = "bbd-pps-gpio";
		gpios = <&gpp17 1 GPIO_ACTIVE_HIGH>;
		/*
		 * assert-falling-edge is read with
		 * device_property_read_bool(), so a present property is true
		 * whatever its value. The vendor writes "= <0>" meaning "no",
		 * which reads as yes; leaving it out is how you say no.
		 */
		status = "okay";
	};
};

&pinctrl_far_alive {
	gps_host_req: gps-host-req-pins {
		samsung,pins = "gpa6-4";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&pinctrl_peric0 {
	gps_mcu_req: gps-mcu-req-pins {
		samsung,pins = "gpp1-1";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	gps_mcu_resp: gps-mcu-resp-pins {
		samsung,pins = "gpp0-0";
		samsung,pin-function = <GS101_PIN_FUNC_INPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
	};

	gps_nstandby: gps-nstandby-pins {
		samsung,pins = "gpp0-2";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	/*
	 * Front camera (IMX355) master clock uses the existing sensor_mclk2_fn
	 * pinmux (gpp5-0 func 2) already defined in gs101-pinctrl.dtsi.
	 */
};

/*
 * BCM4389 WLAN on PCIe HSI2 (channel 1): powered by the always-on
 * wlan_pwrseq regulator (vpcie-supply on pcie1 in gs101.dtsi). No bcmdhd
 * DT node on purpose -- with one, bcmdhd owns wl_reg_on and runs its
 * power-cycle recovery (secondary bus reset), which on this mainline setup
 * knocks the endpoint off the bus (VID 0xffffffff) and never recovers.
 * Without a node bcmdhd assumes an always-on regulator and brings the
 * already-enumerated endpoint up cleanly -- the state that works on cold
 * boot. (This is why adding a node for kexec survival regressed cold boot.)
 */

/*
 * Front camera: Sony IMX355 on HSI2C bus 2 (@0x1a). M1 = probe + chip-ID over
 * I2C (proves slg51000 rails + clock + reset). Master clock is CIS_CLK1 out of
 * CMU_TOP at 24.576 MHz (gs101 has no 19.2 MHz; imx355 driver patched to accept
 * it). reset is active-low in hardware (pin high = run); the mainline driver
 * asserts logical-1 for reset, so declare GPIO_ACTIVE_LOW.
 * CSIS endpoint is wired up in M2.
 */
/* Enable the USI2 wrapper in I2C mode so hsi2c_2 (front camera bus) comes up. */
&usi2 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&hsi2c_2 {
	status = "okay";

	imx355: camera-sensor@1a {
		compatible = "sony,imx355";
		/* Front camera: libcamera Location/Transform (was missing -> "Failed to retrieve the camera location"). */
		orientation = <0>;
		rotation = <270>;	/* sensor mounted rotated 270 deg (user-observed 2026-09-20) */
		reg = <0x1a>;

		/*
		 * Sensor mclk = the final CIS_CLK1 output, which is the divider
		 * (DOUT), not the gate (GOUT) that sits before it. Consuming DOUT
		 * makes imx355 read the true rate and enabling it propagates up
		 * through the gate. mux default parent is oscclk (24.576 MHz), so
		 * the divider resolves to /1. If the CMU cannot honour this, imx355
		 * probe prints the actual rate ("external clock N is not supported").
		 */
		clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK1>;
		/*
		 * Vendor (gs101-oriole-camera.dtsi) runs the imx355 INCK from
		 * CIS_CLK1 at a requested 24000000 Hz with the sensor's 24 MHz
		 * PLL tables, not from the raw 24.576 MHz oscillator. No shared
		 * PLL tap divides to exactly 24 MHz; parent shared2/2 = 400 MHz
		 * gives 400/17 = 23.53 MHz, which the sensor tolerates (the driver
		 * matches the 24 MHz table within 5%).
		 * 2026-09-21: exact 24 MHz via the otherwise unused spare PLL,
		 * programmed to 768 MHz (rate table in clk-gs101.c), divider /32.
		 */
		assigned-clocks = <&cmu_top CLK_FOUT_SPARE_PLL>,
				  <&cmu_top CLK_MOUT_CMU_CIS_CLK1>,
				  <&cmu_top CLK_DOUT_CMU_CIS_CLK1>;
		assigned-clock-parents = <0>,
					 <&cmu_top CLK_FOUT_SPARE_PLL>;
		assigned-clock-rates = <768000000>, <0>, <24000000>;

		reset-gpios = <&gpp4 2 GPIO_ACTIVE_LOW>;

		/*
		 * KNOWN-GOOD rails (imx355 binds on I2C with these). The
		 * production LWIS "ldo1 + ldo_dummy" model does NOT translate to
		 * the mainline regulator model: dvdd/dovdd physically come from the
		 * real SLG LDOs (ldo6/ldo7), not hardwired board rails, so pointing
		 * them at fixed cam_dvdd/cam_dovdd (software no-ops) drops physical
		 * dvdd/dovdd -> sensor unpowered -> -EIO on the chip-id read.
		 */
		avdd-supply = <&slg51000_ldo3>;		/* 2.8 V */
		dvdd-supply = <&slg51000_ldo6>;		/* 1.2 V */
		dovdd-supply = <&slg51000_ldo7>;	/* 1.8 V */

		pinctrl-names = "default";
		pinctrl-0 = <&sensor_mclk2_fn>;

		port {
			imx355_ep: endpoint {
				remote-endpoint = <&csis_sink>;
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <360000000>;
			};
		};
	};

	/*
	 * Front camera module EEPROM (m24c64s), same board as the IMX355 and
	 * powered by the same avdd rail (slg51000_ldo1) but needing no mclk or
	 * reset. Used as a canary: if at24 reads this, avdd + the bus + the slg
	 * LDO1 output are all good, and the IMX355 -EIO is sensor-specific
	 * (dvdd/mclk). If this also fails, the slg power-up (avdd) is the fault.
	 */
	cam_front_eeprom: eeprom@51 {
		compatible = "atmel,24c64";
		reg = <0x51>;
		vcc-supply = <&slg51000_ldo1>;
	};
};

/* Enable the USI1 wrapper in I2C mode so hsi2c_1 (rear main camera bus) comes up. */
&usi1 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

/*
 * Rear main camera: Samsung S5KGN1 on HSI2C bus 1 (@0x3d), 4-lane MIPI,
 * CIS_CLK3 on sensor_mclk4, reset gpp2-2. Rails and enables from the vendor
 * DT (gs101-oriole-camera.dtsi + proto1 overlay): ldo1 avdd, ldo4 dvdd,
 * ldo7 dovdd, SLG51000 GPIO 2/0/1 as "enable"/"shared-enable1/2".
 */
&hsi2c_1 {
	status = "okay";

	s5kgn1: camera-sensor@3d {
		compatible = "samsung,s5kgn1";
		orientation = <1>;
		rotation = <90>;
		reg = <0x3d>;

		clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK3>;
		/* exact 24 MHz from the spare PLL at 768 MHz, divider /32 (see imx355). */
		assigned-clocks = <&cmu_top CLK_FOUT_SPARE_PLL>,
				  <&cmu_top CLK_MOUT_CMU_CIS_CLK3>,
				  <&cmu_top CLK_DOUT_CMU_CIS_CLK3>;
		assigned-clock-parents = <0>,
					 <&cmu_top CLK_FOUT_SPARE_PLL>;
		assigned-clock-rates = <768000000>, <0>, <24000000>;

		reset-gpios = <&gpp2 2 GPIO_ACTIVE_LOW>;
		enable-gpios = <&slg51000 2 GPIO_ACTIVE_HIGH>,
			       <&slg51000 0 GPIO_ACTIVE_HIGH>,
			       <&slg51000 1 GPIO_ACTIVE_HIGH>;

		/*
		 * 2026-09-21: the production SLG51000 OTP routes the enable bits
		 * through its mux array (0x1715..0x171b read 03 05 2c 04 05 2d 02):
		 * framework "ldo1" (bit0) -> physical LDO7 1.8 V, "ldo2" (bit1) ->
		 * LDO1 2.8 V, "ldo3" (bit2) -> LDO4 2.9 V, "ldo4" (bit3) -> LDO2 +
		 * LDO5, "ldo5" (bit4) -> LUT -> LDO6, "ldo7" (bit6) -> GPIO4.
		 * Vendor production GN1 = ldo1 + ldo2 + ldo3. With ldo1/ldo4/ldo7
		 * (proto1 names) the sensor had no 2.8/2.9 V rail and died at
		 * stream-on; with bits 1+2 forced on it streams (runtime test).
		 */
		/* avdd-supply = <&slg51000_ldo1>; */
		/* dvdd-supply = <&slg51000_ldo4>; */
		/* dovdd-supply = <&slg51000_ldo7>; */
		avdd-supply = <&slg51000_ldo2>;		/* bit1 -> LDO1 2.8 V */
		dvdd-supply = <&slg51000_ldo3>;		/* bit2 -> LDO4 2.9 V (production "ldo3"; not a core rail) */
		dovdd-supply = <&slg51000_ldo1>;	/* bit0 -> LDO7 1.8 V */

		pinctrl-names = "default";
		pinctrl-0 = <&sensor_mclk4_fn>;

		port {
			s5kgn1_ep: endpoint {
				remote-endpoint = <&csis1_sink>;
				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;	/* C-PHY, see csis1_sink */
				data-lanes = <1 2 3>;
				link-frequencies = /bits/ 64 <798000000>;
			};
		};
	};
};

/* Enable the USI3 wrapper in I2C mode so hsi2c_3 (rear camera bus) comes up. */
&usi3 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

/*
 * Rear ultra-wide camera: Sony IMX386 on HSI2C bus 3 (@0x1a). 2-lane MIPI,
 * CIS_CLK0 on sensor_mclk1 (gpp3-0). Proto1 rails: avdd=ldo2, dvdd=ldo5,
 * dovdd=ldo7 (shared with IMX355). reset gpp6-3 (active-low in the driver).
 */
&hsi2c_3 {
	status = "okay";

	imx386: camera-sensor@1a {
		compatible = "sony,imx386";
		/* Rear ultra-wide: libcamera Location = back. */
		orientation = <1>;
		rotation = <90>;	/* user-observed after the 0x1e repack (2026-09-20) */
		reg = <0x1a>;

		clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK0>;
		/* Vendor: CIS_CLK0 requested at 24000000 (24 MHz sensor tables); see imx355. */
		/* 2026-09-21: exact 24 MHz from the spare PLL at 768 MHz, divider /32. */
		assigned-clocks = <&cmu_top CLK_FOUT_SPARE_PLL>,
				  <&cmu_top CLK_MOUT_CMU_CIS_CLK0>,
				  <&cmu_top CLK_DOUT_CMU_CIS_CLK0>;
		assigned-clock-parents = <0>,
					 <&cmu_top CLK_FOUT_SPARE_PLL>;
		assigned-clock-rates = <768000000>, <0>, <24000000>;

		reset-gpios = <&gpp6 3 GPIO_ACTIVE_LOW>;

		/* KNOWN-GOOD proto1-style rails (real SLG LDOs, like imx355). */
		avdd-supply = <&slg51000_ldo2>;
		dvdd-supply = <&slg51000_ldo5>;
		dovdd-supply = <&slg51000_ldo7>;

		pinctrl-names = "default";
		pinctrl-0 = <&sensor_mclk1_fn>;

		port {
			imx386_ep: endpoint {
				remote-endpoint = <&csis2_sink>;
				data-lanes = <1 2>;	/* imx386 is 2-lane; 4 corrupts the frame (2026-09-19) */
				link-frequencies = /bits/ 64 <360000000>;
			};
		};
	};
};
