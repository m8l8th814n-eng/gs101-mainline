	status = "okay";
};

&usi8 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&usi7 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&usi11 {
	samsung,mode = <USI_MODE_SPI>;
	status = "okay";
